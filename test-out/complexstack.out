data:
global array vtblListNode: { getValListNode, getNextListNode, 0, 0, 0 }
global array vtblStack: { 0, 0, popStack, pushStack, 0 }
global array vtblStacker: { 0, 0, 0, 0, doStacker }
code:

getValListNode(%this):
	%0 = getelt(%this, 1)
	ret %0
getNextListNode(%this):
	%0 = getelt(%this, 2)
	ret %0

popStack(%this):
	%0 = getelt(%this, 1)
	%1 = %0 == 0
	if %1 then popStack1 else popStack2
popStack1:
	ret 0
popStack2:
	%2 = getelt(%this, 1)
	%3 = load(%2)
	%4 = getelt(%3, 0)
	%5 = call(%4, %2)
	%6 = load(%2)
	%7 = getelt(%6, 1)
	%8 = call(%7, %2)
	setelt(%this, 1, %8)
	ret %5
pushStack(%this, %v):
	%0 = alloc(6)
	setelt(%0, 2, 1)
	%tmp0 = %0 + 24
	store(%tmp0, @vtblListNode)
	setelt(%tmp0, 1, %v)
	%1 = getelt(%this, 1)
	setelt(%tmp0, 2, %1)
	setelt(%this, 1, %tmp0)
	ret 0

doStacker(%this, %stk):
	jump doStacker1
doStacker1:
	%x1 = phi(doStacker2, %x2, doStacker, 20)
	%0 = %x1 > 0
	if %0 then doStacker2 else doStacker3
doStacker2:
	%1 = load(%stk)
	%2 = getelt(%1, 3)
	%3 = call(%2, %stk, %x1)
	%x2 = %x1 - 1
	jump doStacker1
doStacker3:
	%5 = load(%stk)
	%6 = getelt(%5, 2)
	%7 = call(%6, %stk)
	jump doStacker4
doStacker4:
	%v1 = phi(doStacker5, %11, doStacker3, %7)
	%8 = %v1 != 0
	if %8 then doStacker5 else doStacker6
doStacker5:
	print(%v1)
	%9 = load(%stk)
	%10 = getelt(%9, 2)
	%11 = call(%10, %stk)
	jump doStacker4
doStacker6:
	ret 0

main:
	%0 = alloc(5)
	setelt(%0, 2, 1)
	%stk0 = %0 + 24
	store(%stk0, @vtblStack)
	setelt(%stk0, 1, 0)
	%1 = alloc(4)
	setelt(%1, 2, 0)
	%stkr0 = %1 + 24
	store(%stkr0, @vtblStacker)
	%2 = load(%stkr0)
	%3 = getelt(%2, 4)
	%4 = call(%3, %stkr0, %stk0)
	ret 0