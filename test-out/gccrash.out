data:
global array vtblGeneric: { somethingGeneric }
code:

somethingGeneric(%this):
	setelt(%this, 1, 5)
	%1 = getelt(%this, 1)
	ret 0

main:
	jump main1
main1:
	%i1 = phi(main2, %i2, main, 0)
	%0 = %i1 < 5000
	if %0 then main2 else main3
main2:
	%1 = alloc(7)
	setelt(%1, 2, 3)
	%g0 = %1 + 24
	store(%g0, @vtblGeneric)
	%2 = load(%g0)
	%3 = getelt(%2, 0)
	%4 = call(%3, %g0)
	%i2 = %i1 + 1
	jump main1
main3:
	ret 0